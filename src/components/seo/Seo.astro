---
import site from "../../data/siteData.json";
import jsonLDGenerator from "../../utils/jsonLD";
const {title, description, image = site.image, robots = false} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.siteUrl).href;
---
{!robots && <link rel="canonical" href={canonical} />}
<link rel="describedby" href="/llms.txt" />
{!robots && Astro.url.pathname === "/" && <link rel="alternate" type="text/markdown" href="/index.md" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_MX" />
<meta property="og:site_name" content={site.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image.src} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={image.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image.src} />
<meta name="twitter:image:alt" content={image.alt} />
{robots && <meta name="robots" content="noindex" />}
{!robots && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLDGenerator()).replace(/</g, "\\u003c")} />}
