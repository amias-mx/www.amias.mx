---
const {titleTop, titleBottom, link, index} = Astro.props;
---
<a class="initiative" href={link}>
  <h3>{titleTop} {titleBottom}</h3>
  <p>{index === 1 ? "Modelos adaptados al contexto de México para la investigación, la industria y los servicios públicos." : "Desarrollo de capacidades para investigar, construir y utilizar sistemas de inteligencia artificial."}</p>
  <span>Ver objetivo <span aria-hidden="true">→</span></span>
</a>
<style>
  .initiative {display:flex;align-items:flex-start;flex-direction:column;border:1px solid #bccdc1;border-top:4px solid #006847;border-radius:.7rem;background:#f5f7f2;padding:clamp(1.4rem,3.5vw,2.8rem);gap:1rem}
  .initiative:hover {background:#eaf2e9}.initiative h3 {line-height:1.2;text-wrap:balance;max-width:26ch}.initiative p {line-height:1.55;max-width:46ch}
  .initiative>span {color:#075e42;font-weight:500;font-size:1rem;margin-top:auto;text-decoration:underline;text-underline-offset:.25em}
</style>
