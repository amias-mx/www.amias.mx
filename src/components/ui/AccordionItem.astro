---
const {index, title, description} = Astro.props;
---
<details class="objective" id={`objetivo-${index}`} name="objetivos">
  <summary>{title}</summary>
  <p>{description}</p>
</details>
<style>
  .objective {border-top:1px solid #becdc3;padding:0 1rem;scroll-margin-top:6rem}
  .objective:last-child {border-bottom:1px solid #becdc3}
  summary {display:flex;align-items:center;justify-content:space-between;gap:1.5rem;padding:1.25rem 0;font-size:clamp(1.1rem,2vw,1.5rem);font-weight:500;line-height:1.3;cursor:pointer;list-style:none}
  summary::-webkit-details-marker{display:none}
  summary::after {content:"+";font-size:1.6rem;color:#006847}
  details[open] {background:#f0f5ef}
  details[open] summary::after {content:"−"}
  p {max-width:75ch;padding:0 0 1.5rem;line-height:1.6}
</style>
