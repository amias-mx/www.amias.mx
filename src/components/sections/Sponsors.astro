---
import { Image } from "astro:assets";
import s1 from "../../assets/pics/inbest.svg";
import s2 from "../../assets/pics/wow.svg";
import s3 from "../../assets/pics/cocktail.svg";
import s4 from "../../assets/pics/servnet.svg";
import s5 from "../../assets/pics/obok.svg";
import s6 from "../../assets/pics/nextwaveai.svg";
import s7 from "../../assets/pics/propulsion.svg";
import Section from "./Section.astro";

const sponsors = [
  { logo: s1, alt: "iNBest" },
  { logo: s2, alt: "WOW Innovación Creativa" },
  { logo: s3, alt: "Cocktail" },
  { logo: s4, alt: "Servnet" },
  { logo: s5, alt: "Obok" },
  { logo: s6, alt: "Next Wave AI" },
  { logo: s7, alt: "Propulsion Industries" },
];
---

<Section id="sponsors">
  <div class="mb-8">
    <h2 class="mb-5">Participantes</h2>
    <p class="max-w-3xl">
      Estas organizaciones participan en la Alianza Mexicana para la IA Soberana.
    </p>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
    {
      sponsors.map((sponsor) => (
        <div class="flex items-center justify-center h-24 border border-[#dae2dc] rounded-lg">
          <div class="relative w-full max-w-[180px] h-full px-4">
            <Image 
              src={sponsor.logo} 
              alt={sponsor.alt} 
              loading="lazy"
              class="w-full h-full object-contain"
            />
          </div>
        </div>
      ))
    }
  </div>
</Section>