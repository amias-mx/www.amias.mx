---
import { Image } from "astro:assets";
import flag from "../../assets/flag.svg";
import alianza from "../../data/alianza.json";
---
<section id="home" class="hero">
  <div class="hero-inner">
    <div>
      <h1>Inteligencia artificial <em>soberana</em> para México</h1>
      <p>{alianza.intro}</p>
      <div class="hero-actions">
        <a class="btn-primary" href={alianza.join}>Únete a la alianza <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#iniciativas">Explora las iniciativas <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="hero-art"><Image src={flag} alt="Bandera de México" loading="eager" fetchpriority="high" /></div>
  </div>
</section>
<style>
  .hero {background:#f0f5ef;border-bottom:1px solid #cfddcf}
  .hero-inner {max-width:1280px;margin:auto;display:grid;align-items:center;grid-template-columns:1.08fr .92fr;gap:clamp(2rem,5vw,5rem);padding:clamp(3rem,7vw,7rem) clamp(1.25rem,4vw,3.5rem)}
  h1 {font-size:clamp(3rem,5.4vw,5.5rem);line-height:1.01;letter-spacing:-.055em;color:#142e27;text-wrap:balance}
  em {color:#006847;font-style:normal}
  p {max-width:58ch;line-height:1.55;margin:1.5rem 0;color:#344a40;font-size:clamp(1rem,1.45vw,1.2rem)}
  .hero-actions {display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.5rem}
  .hero-art {transform:rotate(-3deg);box-shadow:0 1rem 2rem #153a261a;background:#fff;border-radius:.6rem;overflow:hidden}
  .hero-art img {display:block;width:100%;height:auto}
  @media(max-width:760px){.hero-inner{grid-template-columns:1fr}.hero-art{width:min(88%,29rem);justify-self:center}}
</style>
